*.user
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db

# Local test/debug output that can capture a real device address or a real
# home path. The placeholder addresses hardcoded in source and tests are
# fine and stay -- this is about captured runtime data.
*.log
logs/
*-session.txt
*.pcap

# Secrets -- nothing of the sort exists in this project, and this keeps it so
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# Reference artwork the shipped icons are cut from, and the older brand
# sheet. Never committed: the derived assets/logo/ set is what the project
# actually uses, and these carry pre-rename lettering.
logo.png
image.jpeg
